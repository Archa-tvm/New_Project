# ==========================================
# FlowPulse SaaS Environment Configuration
# ==========================================

# PostgreSQL Configuration
POSTGRES_DB=flowpulse_db
POSTGRES_USER=flowpulse_user
POSTGRES_PASSWORD=flowpulse_secure_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-flowpulse-super-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web-django
DJANGO_PORT=8000

# .NET Workflow Engine Configuration
DOTNET_ENVIRONMENT=Development
DOTNET_PORT=5050
DOTNET_CONNECTION_STRING=Host=postgres;Port=5432;Database=flowpulse_db;Username=flowpulse_user;Password=flowpulse_secure_password_2026;Include Error Detail=true

# Engine Internal Communication URL (for Django to trigger engine)
WORKFLOW_ENGINE_URL=http://engine-dotnet:5050

# Redis Configuration (Optional Message Broker)
REDIS_HOST=redis
REDIS_PORT=6379
